{
  "name": "kym-commons",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "prebuild": "npm run catalog:check",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "catalog:generate": "node scripts/catalog/generate-runtime.mjs",
    "catalog:classify": "node scripts/catalog/classify-packages.mjs",
    "catalog:consolidate": "node scripts/catalog/consolidate-programming-examples.mjs",
    "catalog:deduplicate": "node scripts/catalog/deduplicate-assets.mjs",
    "catalog:consolidate-related": "node scripts/catalog/consolidate-related-materials.mjs",
    "catalog:pair-solutions": "node scripts/catalog/pair-question-solutions.mjs",
    "catalog:check": "npm run catalog:validate && node scripts/catalog/classify-packages.mjs --check && node scripts/catalog/deduplicate-assets.mjs --check && node scripts/catalog/consolidate-programming-examples.mjs --check && node scripts/catalog/consolidate-related-materials.mjs --check && node scripts/catalog/pair-question-solutions.mjs --check && node scripts/catalog/generate-runtime.mjs --check",
    "catalog:migrate": "node scripts/catalog/migrate-legacy.mjs --force"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2",
    "vitest": "^2.1.8"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
