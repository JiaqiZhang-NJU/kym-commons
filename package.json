{
  "name": "kym-commons",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "prebuild": "node scripts/data/prepare-build.mjs",
    "prestart": "node scripts/data/prepare-build.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "catalog:validate": "node scripts/data/prepare-build.mjs",
    "catalog:generate": "node scripts/data/prepare-build.mjs",
    "catalog:check": "node scripts/data/prepare-build.mjs",
    "data:import-legacy": "node scripts/data/import-legacy.mjs",
    "data:fixture": "node scripts/data/create-fixture.mjs",
    "data:export": "node scripts/data/backup.mjs export",
    "data:verify": "node scripts/data/backup.mjs verify",
    "data:restore": "node scripts/data/backup.mjs restore",
    "server": "node server/http.mjs",
    "release": "node scripts/deploy/release.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2",
    "vitest": "^2.1.8"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "serialize-javascript": "7.1.2",
    "tinypool": "2.1.2"
  }
}
