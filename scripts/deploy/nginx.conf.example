# Use the HTTP block first to obtain the certificate; enable HTTPS afterwards.
# When moving servers/domains, replace server_name and both certificate paths.
server {
    listen 80;
    listen [::]:80;
    server_name kymcommons.jqzhang.top;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 308 https://kymcommons.jqzhang.top$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name kymcommons.jqzhang.top;
    ssl_certificate /etc/letsencrypt/live/kymcommons.jqzhang.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kymcommons.jqzhang.top/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:kym_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    root /opt/kym-commons/current/site;
    index index.html;
    charset utf-8;
    access_log off;
    client_max_body_size 128m;
    client_body_timeout 600s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3210;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header Cache-Control no-store always;
    }
    location ^~ /files/ {
        alias /opt/kym-commons/current/files/;
        autoindex off;
        # Keep PDF inline viewing and range requests; sandbox active uploads.
        add_header Content-Security-Policy "sandbox; default-src 'none'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=3600";
    }
    location / {
        try_files $uri $uri/ $uri.html =404;
    }
    location ~ /\. { deny all; }
}
